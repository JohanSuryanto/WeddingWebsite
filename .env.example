# Copy to .env.local and fill in. Never commit .env.local.
# Production values go into each Vercel project's Environment Variables
# (see specs/003-backend-data-persistence/quickstart.md §4).

# --- Database -------------------------------------------------------------
# Local: in-process Postgres (PGlite) saved to disk. Production: Neon pooled URL
# (postgres://…-pooler…/neondb?sslmode=require).
DATABASE_URL=pglite:./.data/dev-db

# --- Media (photos & music) -------------------------------------------------
# local = files in LOCAL_MEDIA_DIR, served at /api/dev/media/… (dev/tests only)
# cloudinary = production
MEDIA_DRIVER=local
# Folder prefix for every file, e.g. wedding/dev locally, wedding/prod in production.
MEDIA_ROOT=wedding/dev
LOCAL_MEDIA_DIR=.data/media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin login ----------------------------------------------------------
# Generate the hash with: npm run hash-password -- "your-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- Secrets ----------------------------------------------------------------
# 32+ random characters. Signs couple passcode cookies and guest ids.
SESSION_SECRET=
# Bearer token Vercel Cron sends to /api/cron/cleanup (admin project only).
CRON_SECRET=

# --- Addresses --------------------------------------------------------------
PUBLIC_ORIGIN=http://localhost:5177
ADMIN_ORIGIN=http://admin.localhost:5177
# Which API routes this deployment serves: public | admin (production), both (dev/tests).
API_SURFACE=both

# Public site address used in couple links (no trailing slash).
# Production: https://wedding.johansuryanto.dev
VITE_PUBLIC_SITE_URL=http://localhost:5177
