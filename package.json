{
  "name": "wedding-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:public && npm run build:admin",
    "preview": "tsx scripts/serve.ts 4817",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "build:public": "npm run typecheck && cross-env SITE=public vite build && npm run build:api",
    "build:admin": "cross-env SITE=admin vite build && npm run build:api",
    "build:api": "node scripts/build-api.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx --import ./scripts/asset-loader.mjs scripts/db-seed.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "check:public-build": "node scripts/check-public-build.mjs",
    "pretest:e2e": "node scripts/generate-fixtures.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/alex-brush": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@hookform/resolvers": "^5.9.1",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^7.18.4",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
